# Shared
ENVIRONMENT=local
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_product_listing
REDIS_URL=redis://redis:6379/0
LOCAL_STORAGE_PATH=storage
PUBLIC_STORAGE_URL=http://localhost:8000/uploads
JWT_SECRET_KEY=dev-only-change-me-please-use-32-plus-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=apl_session
SESSION_COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_TIMEOUT_SECONDS=30
OPENAI_IMAGE_TIMEOUT_SECONDS=90
AI_RETRY_ATTEMPTS=3
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=10
IMAGE_PROVIDER_TIMEOUT_SECONDS=45
# Optional only if switching image enhancement back to remove.bg.
REMOVE_BG_API_KEY=
AWS_REGION=
AWS_S3_BUCKET=
